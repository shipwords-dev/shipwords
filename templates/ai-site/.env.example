# Copy to ~/.config/shipwords/<site>.env outside the repo; pnpm setup:worktree links it in as .env. Never commit real values.
# The same names are the container's environment in production (compose.yaml env_file).

# ---- App ----
APP_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-32-random-bytes
GUEST_COOKIE_SECRET=replace-with-32-random-bytes
# Port start.mjs listens on in production (dev uses the fixed per-site dev port).
PORT=3000

# ---- Database: Postgres, one database per site ----
DATABASE_URL=postgres://site:password@localhost:5432/site_dev

# ---- Object storage: an S3-compatible bucket (Cloudflare R2), or a local directory in development ----
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
STORAGE_DIR=./.data/files

# ---- Email (sign-in codes, job results) and image descriptions: Cloudflare Email Service and Workers AI ----
EMAIL_FROM=noreply@example.com
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# Local development without credentials: write emails, sign-in codes included, to the log instead. Ignored in production.
MAIL_LOG=1
# Where to send notes about delivered jobs that need a human look and failure-streak alerts; unset sends none.
# REVIEW_EMAIL=

# ---- Generation ----
# Get a key at https://yir.ai/?utm_source=shipwords&utm_medium=starter — without it, set UPSTREAM_MOCK=1 to run with a mock upstream.
YIR_API_KEY=
# Test flows for free: 1 = outputs are replaced with reference assets; fail = every segment fails (tests refunds). Only applies when
# APP_URL is local, or on a public demo whose payment keys are all test-mode.
UPSTREAM_MOCK=1
# The compose service (packages/jobs/compose), for effect sites that stitch video: http://compose:8080 in compose.yaml.
# COMPOSE_URL=
# 0 = this process serves pages and API only and runs no generation jobs.
# JOB_WORKER=1

# ---- Sign-in ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Payments: fill the group matching billing.provider in site.config.ts. Use test keys locally. ----
# Run node ../../tools/stripe-listen.mjs in the site dir to forward webhooks; it writes whsec back to .env.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# For PayPal fill this group and leave Stripe empty; use sandbox locally.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# ---- Bot defense ----
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=

# ---- Analytics ----
# Rybbit API URL (e.g. https://rybbit.example.com/api) when site.config.ts sets analytics.rybbit; the site's /stats/ proxies to it.
RYBBIT_UPSTREAM=
