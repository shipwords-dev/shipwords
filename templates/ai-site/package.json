{
  "name": "@shipwords/template-ai-site",
  "private": true,
  "type": "module",
  "devPort": 5010,
  "scripts": {
    "dev": "node --env-file-if-exists=.env ../../tools/dev-port.mjs vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env start.mjs",
    "preview": "vite build && node --env-file-if-exists=.env start.mjs",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsr generate && tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && pnpm check:site",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env migrate.mjs",
    "check:site": "node ../../tools/check-site.mjs ."
  },
  "dependencies": {
    "@shipwords/core": "workspace:*",
    "@shipwords/jobs": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.14",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "srvx": "1.0.8"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.27.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.46",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
