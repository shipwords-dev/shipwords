{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Example config: resource names, domain and IDs are placeholders. Create your own resources and fill them in before deploying.
  "name": "tinydeskai-example",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // Add your domain before deploying: "routes": [{ "pattern": "your-domain.com", "custom_domain": true }],
  // Sample videos go through the Worker so Range requests get 206 (iPhone Safari won't play otherwise), see src/lib/video-range.ts.
  "assets": { "binding": "STATIC", "run_worker_first": ["/media/*"] },
  "vars": {
    "EMAIL_FROM": "noreply@tinydeskai.example.com",
    // Rybbit collector URL, used only inside the Worker (/stats/* proxy); leave empty to disable.
    "RYBBIT_UPSTREAM": "",
    // Delivered jobs whose repair passes couldn't swap everyone (or put a face on the wrong person) also send a note here; empty sends none.
    "REVIEW_EMAIL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinydeskai-example",
      "database_id": "<set after wrangler d1 create>",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "OUTPUTS", "bucket_name": "tinydeskai-example-outputs" }],
  "send_email": [{ "name": "EMAIL" }],
  // Workers AI: describes each person's prepped reference photo in one phrase for the video prompt (effect.describe).
  "ai": { "binding": "AI" },
  "workflows": [
    {
      "name": "tinydeskai-example-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow"
    }
  ],
  // Effect compose container: ffmpeg image in packages/jobs/compose. Uses durable_object scheduling; the instance type
  // (standard-3: 2 vCPU, 8 GiB; on standard-1's 1/2 vCPU the face check took 25–30 s and compose 60 s) is set in start() in server.ts.
  "containers": [
    {
      "class_name": "ComposeContainer",
      "scheduling_policy": "durable_object",
      "images": { "compose": { "dockerfile": "../../packages/jobs/compose/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "COMPOSE", "class_name": "ComposeContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ComposeContainer"] }],
  // Local dev neither builds nor runs the container (no Docker needed); with UPSTREAM_MOCK=1 the mock composer is used instead.
  "dev": { "enable_containers": false }
}
